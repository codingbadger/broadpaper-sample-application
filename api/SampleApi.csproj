<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SampleApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restored from vendor/nuget via the nuget.config at the repository root.
         This is the multi-targeted package: on net10.0 it resolves lib/net10.0,
         and an application on net8.0 would get lib/net8.0 from the same file. -->
    <PackageReference Include="BroadPaper.Client" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Already Content by default under the Web SDK; this only asks for them
         beside the binary, where AppContext.BaseDirectory looks. -->
    <Content Update="data/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
