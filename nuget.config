<?xml version="1.0" encoding="utf-8"?>
<!--
  BroadPaper.Client is not on nuget.org yet, so this sample restores it from the
  packed .nupkg in vendor/nuget. Replace the whole file with nothing once the
  package is published: `dotnet add package BroadPaper.Client` will then find it
  on nuget.org like any other dependency.
-->
<configuration>
  <packageSources>
    <add key="broadpaper-local" value="vendor/nuget" />
  </packageSources>
</configuration>
