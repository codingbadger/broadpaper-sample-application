/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    /* Two resolution overrides, both working around how the packages are built
       today, and neither of which should survive contact with published
       versions - see "Two things the packages need" in the README.

       1. @broadpaper/angular is bundled with tsup, so its @Component
          decorators never become Angular Ivy definitions and Angular rejects
          the export as "not a standalone component". The package does ship its
          TypeScript source, so pointing at that has this app's own Angular
          compiler compile it - which is what an Angular library build would
          have done ahead of time.

       2. @broadpaper/forme reaches @formepdf/core through a dynamic import on
          a fallback path this app never takes, but a bundler still has to
          resolve it, and the default browser entry is the bundler-target build
          that imports its .wasm as an ES module. Angular refuses that in a
          Zone.js application. The worker entry is the same engine built for
          explicit initialisation, which browser-pdf.ts does anyway. */
    "paths": {
      "@broadpaper/angular": ["./node_modules/@broadpaper/angular/src/index.ts"],
      "@formepdf/core": ["./node_modules/@formepdf/core/dist/worker.js"]
    },
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
